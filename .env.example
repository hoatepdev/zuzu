# Development defaults. Use separate credentials and databases for staging and production.
NODE_ENV=development
DATABASE_URL=postgresql://zuzu:zuzu@localhost:5433/zuzu?schema=public
SESSION_SECRET=development-only-change-me
CORS_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3100
PRINT_AGENT_TOKEN=development-print-agent-token
PRINT_JOB_CLAIM_TIMEOUT_MS=60000
PORT=3100

# Production example (placeholders only; never commit real values):
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zuzu?sslmode=require&schema=public
# SESSION_SECRET=<random-secret>
# CORS_ORIGIN=https://app.example.com
# WEB_URL=https://app.example.com
# VITE_API_URL=https://api.example.com
# PRINT_AGENT_TOKEN=<random-agent-token>

# Set to none ONLY for staging on unrelated provider domains (*.pages.dev + *.up.railway.app);
# iPhone Safari blocks third-party cookies there. Production on app.<domain>/api.<domain> keeps lax (default).
# COOKIE_SAMESITE=lax
