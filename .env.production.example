# Copy to .env.production on the VPS and fill in real values.
# Generate secrets with: openssl rand -hex 32
# Never commit the real .env.production.

NODE_ENV=production
DB_PASSWORD=<strong-postgres-password>
SESSION_SECRET=<random-long-secret>
PRINT_AGENT_TOKEN=<random-long-agent-secret>
PRINT_JOB_CLAIM_TIMEOUT_MS=60000

# Domains — DNS A records for both must point at the VPS IP.
API_DOMAIN=api.example.com
WEB_DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# Absolute URLs used by API CORS/cookies and baked into the web bundle.
CORS_ORIGIN=https://app.example.com
WEB_URL=https://app.example.com
VITE_API_URL=https://api.example.com
