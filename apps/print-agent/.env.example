# ZUZU Print Agent
PORT=3210
BIND_HOST=127.0.0.1

# console | usb | tcp
PRINTER_CONNECTION=console

# usb (find VID/PID in README):
# PRINTER_CONNECTION=usb
# PRINTER_VENDOR_ID=0x0483
# PRINTER_PRODUCT_ID=0x5720

# tcp (LAN printer, later):
# PRINTER_CONNECTION=tcp
# PRINTER_HOST=192.168.1.100
# PRINTER_PORT=9100

# utf8 (printer native) | ascii (bỏ dấu nếu máy in không hỗ trợ tiếng Việt)
PRINTER_ENCODING=utf8
