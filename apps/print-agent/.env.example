NODE_ENV=development

# Cloud API. Required for the outbound worker.
ZUZU_API_URL=http://localhost:3100
PRINT_AGENT_TOKEN=development-print-agent-token
POLL_INTERVAL_MS=2000

# Development-only local health and /print server.
PORT=3210
BIND_HOST=127.0.0.1

# console | usb | tcp
PRINTER_CONNECTION=console

# usb (find VID/PID in README):
# PRINTER_CONNECTION=usb
# PRINTER_VENDOR_ID=0x0483
# PRINTER_PRODUCT_ID=0x5720

# tcp:
# PRINTER_CONNECTION=tcp
# PRINTER_HOST=192.168.1.100
# PRINTER_PORT=9100

# ascii (safe default, bỏ dấu) | utf8 (only if printer supports Vietnamese)
# Unsupported values also fall back to ascii.
PRINTER_ENCODING=ascii
