{
  "name": "zuzu",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @zuzu/api & npm run dev --workspace @zuzu/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace @zuzu/api && npm run test --workspace @zuzu/print-agent",
    "db:migrate": "npm run db:migrate --workspace @zuzu/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @zuzu/api",
    "db:seed": "npm run db:seed --workspace @zuzu/api",
    "test:web": "npm run test --workspace @zuzu/web",
    "test:e2e": "npm run test:e2e --workspace @zuzu/web",
    "api:generate": "npm run api:generate --workspace @zuzu/web"
  },
  "engines": {
    "node": ">=22"
  }
}
